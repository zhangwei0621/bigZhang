<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center">

        <com.study.openpdfdemo.viewer.view.PdfView
            android:id="@+id/pdf_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:layout_constraintEnd_toStartOf="@id/ll_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="file path" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_index"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toStartOf="@id/ll_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_path"
        tools:text="1/3" />

    <LinearLayout
        android:id="@+id/ll_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_refresh_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新当前页" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_last_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上一页" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一页" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="工具" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dont_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="不保存" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="撤销" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重做" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索测试" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_search_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索:↑" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_search_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索:↓" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>